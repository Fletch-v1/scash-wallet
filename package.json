    "@types/node": "^20.2.5",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "eslint": "^8.0.0",
    "prettier": "^2.8.8"
